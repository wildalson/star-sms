    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "25.3.5",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "drizzle-kit": "0.31.9",
